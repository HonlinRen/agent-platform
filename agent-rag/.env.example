# DashScope (通义千问 / Embedding)
DASHSCOPE_API_KEY=your_dashscope_api_key
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3
DASHSCOPE_LLM_MODEL=qwen-plus
# OpenAI 兼容模式（DashScope Chat Completions）
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Chroma
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8000
# 默认知识库 collection（半导体）；汽车安全入库使用 collection 名 white_paper_iot
CHROMA_COLLECTION_NAME=semiconductor

# Ingest
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Retrieval + local rerank
RETRIEVAL_TOP_N=15
RETRIEVAL_FINAL_TOP_K=5
RERANK_ENABLED=true
RERANK_MODEL=BAAI/bge-reranker-base
# 本地模型目录（download_rerank_model.py 下载后默认可不填）
# RERANK_MODEL_PATH=models/bge-reranker-base
RERANK_DEVICE=auto
# HuggingFace 镜像（仅在线拉模型时用；国内推荐先跑 download_rerank_model.py）
HF_ENDPOINT=https://hf-mirror.com

# Chat
CHAT_WINDOW_SIZE=5
MAX_TOOL_ROUNDS=3
MAX_RETRIEVE_RETRIES=2
# 单请求预算（0 或负数表示禁用该项）
MAX_REQUEST_TOKENS=12000
MAX_GRAPH_RUNTIME_SECONDS=90
RETRIEVAL_MIN_SCORE=0.15
# 本地检索分数低于此值时触发 Tavily 补充（需高于 RETRIEVAL_MIN_SCORE）
RETRIEVAL_SUPPLEMENT_SCORE=0.45

# Agent / LangGraph
CHECKPOINT_ENABLED=true
REDIS_CHECKPOINT_PREFIX=checkpoint:rag:
GATEWAY_BASE_URL=http://127.0.0.1:8080

# LangSmith (optional trace, parallel with OpenTelemetry)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your_langsmith_key
# LANGCHAIN_PROJECT=agent-rag

# OpenTelemetry
OTEL_SERVICE_NAME=agent-rag
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
# OTEL_CONSOLE_EXPORTER=true
# RAG_VERBOSE_RETRIEVAL=false

# Application logging
LOG_LEVEL=INFO
LOG_FORMAT=text
# LOG_FORMAT=json

# MCP whitepaper server (Phase 3)
MCP_ENABLED=false
# MCP_WHITEPAPER_COMMAND=python mcp_servers/whitepaper/server.py
# MCP_WHITEPAPER_URL=http://127.0.0.1:8090/sse

# Tavily 联网检索（web 路由直达 + 本地检索失败/偏低时补充）
# 未配置时 web 路由将拒答，本地检索失败也不会联网
TAVILY_KEY=
TAVILY_ENABLED=true
TAVILY_SEARCH_DEPTH=advanced
TAVILY_MAX_RESULTS=5
# MCP tavily server (optional, for Cursor / ops)
# python mcp_servers/tavily/server.py

# Redis（metrics 计数，与 agent-gateway 共用实例）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# RAG quality eval (scripts/run_quality_eval.py, tests/test_quality_check.py)
# EVAL_INTEGRATION=1
# RAG_API_URL=http://127.0.0.1:8081
# EVAL_JUDGE_MODEL=qwen-plus
# RAG_EVAL_TIMEOUT=120

# FastAPI
API_HOST=127.0.0.1
API_PORT=8081
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# API_RELOAD=true

# MySQL 对话持久化
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
# 密码变量名固定为 MySql_Password（与部署约定一致；也支持 MYSQL_PASSWORD）
# MySql_Password=your_password
MYSQL_DATABASE=appdb

# Alibaba Cloud (DocMind 文档解析，使用默认凭据链时可留空)
# ALIBABA_CLOUD_ACCESS_KEY_ID=
# ALIBABA_CLOUD_ACCESS_KEY_SECRET=

# DocMind 文档解析（大模型版）
# DOCMIND_ENDPOINT=docmind-api.cn-hangzhou.aliyuncs.com
DOCMIND_OUTPUT_FORMAT=markdown
DOCMIND_LLM_ENHANCEMENT=false
# DOCMIND_ENHANCEMENT_MODE=VLM
DOCMIND_LAYOUT_STEP_SIZE=100
