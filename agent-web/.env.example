# API 经 gateway 代理时留空（vite 代理到 8080）；直连 RAG 可设 http://127.0.0.1:8081
VITE_API_BASE_URL=

# 聊天页展示哪些知识库：编辑 config/knowledge-bases.json（visibleInChat、defaultChatCollection）
# 知识库名称目录在 src/constants/knowledgeBases.ts 的 KNOWLEDGE_BASE_CATALOG

# 本地 Docker 观测栈（deploy/observability）
VITE_GRAFANA_URL=http://localhost:3000/d/agent-observability
VITE_PROMETHEUS_URL=http://localhost:9090
